      "boundElements": null,
      "updated": 1791610782040,
      "link": null,
      "locked": false,
      "text": "Why a registry? Code-built UI never \"references\" a font or shader in a scene, so Unity could leave it out of\nthe build. Anything listed in an asset under Resources/ always ships.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why a registry? Code-built UI never \"references\" a font or shader in a scene, so Unity could leave it out of\nthe build. Anything listed in an asset under Resources/ always ships.",
      "autoResize": true,
      "lineHeight": 1.25
    },
